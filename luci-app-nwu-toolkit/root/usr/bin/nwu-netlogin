#!/bin/sh
# 校园网 Dr.COM 自动认证
#   nwu-netlogin daemon   常驻运行：定期检测并自动重登
#   nwu-netlogin once     只执行一轮（手动测试 / LuCI 按钮）
#
# 依赖：curl、jsonfilter、ip（均为系统自带或已安装）

. /usr/lib/nwu-toolkit/common.sh

STATE_FILE="$NWU_STATE_DIR/netlogin.json"
LOCK_DIR="$NWU_STATE_DIR/netlogin.lock"
# 打卡切号期间由 nwu-daka 置位，守护进程看到后暂停自动重登，避免把账号抢回去
HOLD_FILE="$NWU_STATE_DIR/netlogin.hold"
DEFAULT_UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'

say() { nwu_log "netlogin: $*"; }

load_conf() {
	PORTAL=$(nwu_get netlogin.portal 'http://172.30.9.18:801')
	PORTAL_DOMAIN=$(nwu_get netlogin.portal_domain 'http://calogin.nwu.edu.cn:801')
	INTERVAL=$(nwu_get netlogin.interval 60)
	SWITCH_MIN=$(nwu_get netlogin.switch_interval 0)
	FAILOVER=$(nwu_get netlogin.failover 1)
	UA=$(nwu_get netlogin.ua "$DEFAULT_UA")
	case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=60 ;; esac
	[ "$INTERVAL" -lt 15 ] && INTERVAL=15
	case "$SWITCH_MIN" in ''|*[!0-9]*) SWITCH_MIN=0 ;; esac
	case "$FAILOVER" in 1|on|true|yes) FAILOVER=1 ;; *) FAILOVER=0 ;; esac
}

account_label() { # section
	local n
	n=$(uci -q get "nwu-toolkit.$1.name")
	[ -n "$n" ] && printf '%s' "$n" || printf '%s' "$1"
}

list_enabled_accounts() {
	local s out=''
	for s in $(nwu_sections account); do
		nwu_list_enabled "$s" && out="$out $s"
	done
	printf '%s' "${out# }"
}

is_portal() { # base
	local body
	body=$(curl -s -m 6 --connect-timeout 3 "$1/eportal/portal/page/loadConfig?callback=dr1" 2>/dev/null)
	case "$body" in
		*'"code"'*) return 0 ;;
	esac
	return 1
}

# 认证服务器探测：配置地址 → 被劫持响应 → 网关/校内已知地址
detect_portal() {
	local c base resp gw u
	for c in "$PORTAL" "$PORTAL_DOMAIN"; do
		[ -n "$c" ] || continue
		if is_portal "$c"; then
			printf '%s' "$c"
			return 0
		fi
	done

	for u in http://www.baidu.com http://connectivitycheck.gstatic.com/generate_204 \
		http://1.1.1.1 http://110.242.68.66; do
		resp=$(curl -s -m 6 --connect-timeout 3 -D - "$u" 2>/dev/null)
		[ -n "$resp" ] || continue
		base=$(printf '%s' "$resp" | grep -oE "http[^\"' <>]*/eportal" | head -n1 | sed 's#/eportal.*##')
		if [ -n "$base" ] && is_portal "$base"; then
			printf '%s' "$base"
			return 0
		fi
	done

	gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
	for c in "$gw" "$gw:801" "$gw:8081" 172.30.9.18:801 172.30.9.18 \
		10.16.0.12:8081 10.0.1.165 10.0.1.165:801 10.0.1.242 10.0.1.242:801; do
		[ -n "$c" ] || continue
		case "$c" in
			http*) ;;
			*) c="http://$c" ;;
		esac
		if is_portal "$c"; then
			printf '%s' "$c"
			return 0
		fi
	done

	return 1
}

# 刚重连/换 MAC 后网络可能还没完全就绪，探测失败时重试几次
wait_portal() {
	local i=0 p
	while [ "$i" -lt 4 ]; do
		p=$(detect_portal)
		[ -n "$p" ] && {
			printf '%s' "$p"
			return 0
		}
		sleep 4
		i=$((i + 1))
	done
	return 1
}

# 成功时把说明写入 LAST_MSG
do_login() { # portal user pass
	local resp msg
	resp=$(curl -s -m 12 --connect-timeout 4 -G "$1/eportal/portal/login" \
		-H 'Referer: http://calogin.nwu.edu.cn/' \
		-H "User-Agent: $UA" \
		--data-urlencode "user_account=$2" \
		--data-urlencode "user_password=$3" \
		--data 'login_method=1' \
		--data 'terminal_type=1' \
		--data 'lang=zh-cn' \
		--data 'callback=dr1' \
		--data 'jsVersion=4.2.1' 2>/dev/null)
	case "$resp" in
		*'"result":1'*|*'"result":"ok"'*)
			LAST_MSG='认证成功'
			return 0
			;;
		*'"ret_code":2'*)
			LAST_MSG='该 IP 已在线'
			return 0
			;;
	esac
	msg=$(printf '%s' "$resp" | sed -n 's/.*"msg":"\([^"]*\)".*/\1/p' | head -n1)
	if [ -n "$msg" ]; then
		LAST_MSG="$msg"
	else
		[ -z "$resp" ] && LAST_MSG='认证请求无响应' || LAST_MSG='认证失败'
	fi
	return 1
}

do_logout() { # portal user
	[ -n "$1" ] && [ -n "$2" ] || return 0
	curl -s -m 8 --connect-timeout 3 "$1/eportal/portal/logout" \
		-H "User-Agent: $UA" \
		--data-urlencode "user_account=$2" \
		--data 'login_method=1' \
		--data 'callback=dr1' >/dev/null 2>&1
}

save_state() { # index switch_ts user label result msg
	local old_r old_m old_a
	old_r=$(nwu_file_json_get "$STATE_FILE" '@.result')
	old_m=$(nwu_file_json_get "$STATE_FILE" '@.msg')
	old_a=$(nwu_file_json_get "$STATE_FILE" '@.account')
	printf '{"index":%s,"switch_ts":%s,"user":"%s","account":"%s","result":"%s","msg":"%s","time":"%s"}\n' \
		"$1" "$2" "$(nwu_json_escape "$3")" "$(nwu_json_escape "$4")" \
		"$5" "$(nwu_json_escape "$6")" "$(date '+%Y-%m-%d %H:%M:%S')" >"$STATE_FILE"
	if [ "$old_r" != "$5" ] || [ "$old_m" != "$6" ] || [ "$old_a" != "$4" ]; then
		say "$4：$6"
	fi
}

run_once() {
	local accounts total idx now sw_ts prev_user target user pass label portal tries rc

	accounts=$(list_enabled_accounts)
	if [ -z "$accounts" ]; then
		say '没有启用的账号，跳过'
		return 1
	fi

	set -- $accounts
	total=$#
	idx=$(nwu_file_json_get "$STATE_FILE" '@.index')
	case "$idx" in ''|*[!0-9]*) idx=1 ;; esac
	[ "$idx" -ge 1 ] && [ "$idx" -le "$total" ] || idx=1

	now=$(date +%s)
	sw_ts=$(nwu_file_json_get "$STATE_FILE" '@.switch_ts')
	case "$sw_ts" in ''|*[!0-9]*) sw_ts=$now ;; esac

	if [ "$SWITCH_MIN" -gt 0 ] && [ $((now - sw_ts)) -ge $((SWITCH_MIN * 60)) ]; then
		prev_user=$(nwu_file_json_get "$STATE_FILE" '@.user')
		if [ -n "$prev_user" ]; then
			portal=$(detect_portal)
			[ -n "$portal" ] && do_logout "$portal" "$prev_user"
		fi
		idx=$(( idx % total + 1 ))
		sw_ts=$now
		say "到达换号周期，切换到第 $idx 个账号"
	fi

	eval "target=\${$idx}"
	tries=0
	while [ "$tries" -lt "$total" ]; do
		user=$(uci -q get "nwu-toolkit.$target.username")
		pass=$(uci -q get "nwu-toolkit.$target.password")
		label=$(account_label "$target")

		if [ -z "$user" ] || [ -z "$pass" ]; then
			say "账号 $label 缺少账号或密码，跳过"
			save_state "$idx" "$sw_ts" '' "$label" 'fail' '账号或密码为空'
			idx=$(( idx % total + 1 ))
			eval "target=\${$idx}"
			tries=$((tries + 1))
			continue
		fi

		portal=$(detect_portal)
		if [ -z "$portal" ]; then
			save_state "$idx" "$sw_ts" "$user" "$label" 'fail' '认证服务器不可达'
			return 1
		fi

		LAST_MSG=''
		if do_login "$portal" "$user" "$pass"; then
			save_state "$idx" "$sw_ts" "$user" "$label" 'ok' "$LAST_MSG"
			return 0
		fi

		save_state "$idx" "$sw_ts" "$user" "$label" 'fail' "$LAST_MSG"
		if [ "$FAILOVER" != '1' ]; then
			return 1
		fi
		idx=$(( idx % total + 1 ))
		eval "target=\${$idx}"
		tries=$((tries + 1))
	done

	rc=1
	return $rc
}

current_ip() {
	ip -4 route get 1.1.1.1 2>/dev/null |
		awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1);exit}}'
}

# ---- MAC / 重连：让每个账号以不同身份、不同 IP 打卡 ----
# 实测 network.<iface>.macaddr 对 mt76 STA 无效，但 wireless.<wifi-iface>.macaddr 有效
STA_META_FILE="$NWU_STATE_DIR/wan.sta.meta"
STA_ORIG_FILE="$NWU_STATE_DIR/wan.sta.macaddr"
STA_TS_FILE="$NWU_STATE_DIR/wan.sta.ts"
STA_GUARD_PID="$NWU_STATE_DIR/wan.sta.guard"

sta_section() { # wan iface -> 无线 station 节名
	local s net
	for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([A-Za-z0-9_]*\)\.mode='sta'$/\1/p"); do
		net=$(uci -q get "wireless.$s.network")
		case " $net " in
			*" $1 "*) printf '%s' "$s"; return 0 ;;
		esac
	done
	s=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([A-Za-z0-9_]*\)\.mode='sta'$/\1/p" | head -1)
	[ -n "$s" ] && printf '%s' "$s"
}

mac_restore() {
	local sec iface orig
	[ -s "$STA_META_FILE" ] || return 0
	read -r sec iface <"$STA_META_FILE"
	orig=$(cat "$STA_ORIG_FILE" 2>/dev/null)
	if [ -n "$sec" ] && [ -n "$iface" ]; then
		if [ -n "$orig" ]; then
			uci set "wireless.$sec.macaddr=$orig"
		else
			uci -q delete "wireless.$sec.macaddr"
		fi
		uci commit wireless 2>/dev/null
		ifdown "$iface" >/dev/null 2>&1
		ifup "$iface" >/dev/null 2>&1
	fi
	rm -f "$STA_META_FILE" "$STA_ORIG_FILE" "$STA_TS_FILE" "$STA_GUARD_PID"
}

# 看门狗：180 秒内没有新的切号动作就恢复原始 MAC，避免异常退出后长期占用伪 MAC
mac_guard() {
	[ -e "$STA_GUARD_PID" ] && return 0
	(
		while :; do
			sleep 10
			[ -s "$STA_META_FILE" ] || exit 0
			ts=$(cat "$STA_TS_FILE" 2>/dev/null || echo 0)
			now=$(date +%s)
			if [ $((now - ts)) -ge 180 ]; then
				mac_restore
				exit 0
			fi
		done
	) >/dev/null 2>&1 &
	echo $! >"$STA_GUARD_PID"
}

mac_switch() { # mac
	local meta dev iface sec i=0
	meta=$(wan_meta) || return 1
	dev=${meta% *}
	iface=${meta#* }
	[ -n "$dev" ] || return 1
	sec=$(sta_section "$iface")
	[ -n "$sec" ] || return 1
	if [ ! -s "$STA_META_FILE" ]; then
		printf '%s %s' "$sec" "$iface" >"$STA_META_FILE"
		uci -q get "wireless.$sec.macaddr" >"$STA_ORIG_FILE" 2>/dev/null || : >"$STA_ORIG_FILE"
	fi
	mac_guard
	date +%s >"$STA_TS_FILE"
	uci set "wireless.$sec.macaddr=$1"
	uci commit wireless 2>/dev/null
	ifdown "$iface" >/dev/null 2>&1
	ifup "$iface" >/dev/null 2>&1
	while [ "$i" -lt 25 ]; do
		[ -n "$(current_ip)" ] && return 0
		sleep 2
		i=$((i + 1))
	done
	mac_restore
	return 1
}

wan_meta() { # 输出 "dev iface"，iface 为 netifd 接口名
	local dev i iface
	dev=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)
	[ -n "$dev" ] || return 1
	iface=''
	if command -v ubus >/dev/null 2>&1; then
		for i in $(ubus list 'network.interface.*' 2>/dev/null | sed 's/^network\.interface\.//'); do
			case "$i" in loopback|lan) continue ;; esac
			if [ "$(ubus call "network.interface.$i" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)" = "$dev" ]; then
				iface="$i"
				break
			fi
		done
	fi
	printf '%s %s' "$dev" "${iface:-wan}"
}

# 重连 WAN：断开 WiFi 再连，触发新的 DHCP 租约（出口 IP 会变）
reconnect_wan() {
	local meta dev iface i=0
	meta=$(wan_meta) || return 1
	dev=${meta% *}
	iface=${meta#* }
	[ -n "$dev" ] || return 1
	ifdown "$iface" >/dev/null 2>&1
	ifup "$iface" >/dev/null 2>&1
	while [ "$i" -lt 25 ]; do
		[ -n "$(current_ip)" ] && return 0
		sleep 2
		i=$((i + 1))
	done
	# 补一次，仍然失败才判定为不可用
	ifup "$iface" >/dev/null 2>&1
	i=0
	while [ "$i" -lt 25 ]; do
		[ -n "$(current_ip)" ] && return 0
		sleep 2
		i=$((i + 1))
	done
	return 1
}

# 临时切换到指定账号（打卡前使用）：注销 → 换 MAC/重连 → 登录新账号
switch_account() { # user pass [mac] [reconnect]
	local portal old_ip new_ip i=0 idx prev_user
	portal=$(detect_portal)
	idx=$(nwu_file_json_get "$STATE_FILE" '@.index')
	case "$idx" in ''|*[!0-9]*) idx=0 ;; esac

	old_ip=$(current_ip)
	prev_user=$(nwu_file_json_get "$STATE_FILE" '@.user')
	if [ -n "$portal" ] && [ -n "$prev_user" ]; then
		do_logout "$portal" "$prev_user"
	fi

	if [ -n "$3" ]; then
		if ! mac_switch "$3"; then
			printf '更换 MAC 后网络未能恢复'
			return 1
		fi
		portal=$(wait_portal)
	elif [ "$4" = '1' ]; then
		if ! reconnect_wan; then
			printf '重连 WiFi 后网络未能恢复'
			return 1
		fi
		portal=$(wait_portal)
	fi

	if [ -z "$portal" ]; then
		printf '认证服务器不可达'
		return 1
	fi

	LAST_MSG=''
	if ! do_login "$portal" "$1" "$2"; then
		printf '%s' "$LAST_MSG"
		return 1
	fi

	i=0
	while [ "$i" -lt 15 ]; do
		new_ip=$(current_ip)
		if [ -n "$new_ip" ] && [ "$new_ip" != "$old_ip" ]; then
			save_state "$idx" "$(date +%s)" "$1" "$1" 'ok' "已切换到 $1（打卡）"
			printf 'IP %s → %s' "$old_ip" "$new_ip"
			return 0
		fi
		sleep 2
		i=$((i + 1))
	done

	save_state "$idx" "$(date +%s)" "$1" "$1" 'ok' "已切换到 $1（打卡，IP 未变）"
	printf '%s 登录成功，但 IP 未变化（%s）' "$1" "$old_ip"
	return 0
}

cmd_switch() {
	local i=0 rc
	[ -n "$1" ] && [ -n "$2" ] || {
		printf '缺少校园网账号或密码'
		return 2
	}
	nwu_init_dirs
	load_conf
	while ! nwu_lock "$LOCK_DIR"; do
		i=$((i + 1))
		if [ "$i" -gt 10 ]; then
			printf '认证任务繁忙，稍后再试'
			return 1
		fi
		sleep 2
	done
	switch_account "$1" "$2" "$3" "$4"
	rc=$?
	nwu_unlock "$LOCK_DIR"
	return $rc
}

cmd_mac_restore() {
	nwu_init_dirs
	mac_restore
}

daemon() {
	nwu_init_dirs
	say '守护进程启动'
	while :; do
		load_conf
		# 打卡正在借用校园网账号（nwu-daka 置位），暂停自动重登
		if [ -e "$HOLD_FILE" ]; then
			sleep 15
			continue
		fi
		if nwu_bool netlogin.enabled; then
			if nwu_lock "$LOCK_DIR"; then
				run_once
				nwu_unlock "$LOCK_DIR"
			fi
		else
			sleep 30
			continue
		fi
		sleep "$INTERVAL"
	done
}

once() {
	local rc
	nwu_init_dirs
	load_conf
	if ! nwu_lock "$LOCK_DIR"; then
		say '已有认证任务在运行，跳过'
		return 1
	fi
	run_once
	rc=$?
	nwu_unlock "$LOCK_DIR"
	return $rc
}

case "$1" in
	daemon) daemon ;;
	once) once ;;
	switch) cmd_switch "$2" "$3" "$4" "$5" ;;
	mac-restore) cmd_mac_restore ;;
	*)
		echo "用法: $0 daemon|once|switch <账号> <密码> [MAC] [1=重连]|mac-restore" >&2
		exit 1
		;;
esac
