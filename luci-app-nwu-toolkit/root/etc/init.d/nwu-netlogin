#!/bin/sh /etc/rc.common
# 校园网自动登录守护进程（procd 管理，开机自启、异常退出自动拉起）

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/nwu-netlogin daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
