#!/bin/sh /etc/rc.common
# OpenWrt procd 服务：开机自启 NWUNET 自动认证守护进程
# 安装后执行：/etc/init.d/nwunet-autologin enable && /etc/init.d/nwunet-autologin start

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/nwunet-autologin
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
